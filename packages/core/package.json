{
  "name": "@hhc/core",
  "version": "0.1.0",
  "private": true,
  "description": "AI 등산 코치 도메인 코어 — 플랫폼 중립 (웹 · iOS · Android · 서버 공유)",
  "type": "module",
  "main": "./dist/core.mjs",
  "module": "./dist/core.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.mjs",
      "default": "./dist/core.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.config.demo.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:purity": "node scripts/check-purity.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
